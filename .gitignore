# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so content is dynamic
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nosenv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
ENV/
env/
active_env/

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
.project
.pydevproject
.settings/

# Streamlit local credentials & runtime configs (optional, but safe to ignore cache/history)
.streamlit/runtime/
.streamlit/secret.toml

# System Files
.DS_Store
Thumbs.db
desktop.ini

# Project Specific Ignored Data
# Ignore private key files
.env
.env.*
!.env.example

# Ignore local deck history outputs
exports/*.json
exports/*.csv
exports/*.apkg
